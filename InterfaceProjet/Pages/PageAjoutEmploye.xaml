<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAjoutEmploye"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfaceProjet.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITRE -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="10"
                        Margin="0,0,0,20">
                <SymbolIcon Symbol="People"/>
                <TextBlock Text="Ajout d'un employé"
                           FontSize="28"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <!-- CARTE FORMULAIRE -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Center"
                    CornerRadius="12"
                    Padding="24"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12"
                            MaxWidth="600">

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Width="280">
                            <TextBox x:Name="tbxNom" Header="Nom"/>
                            <TextBlock x:Name="tblErrNom" Foreground="Red" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Width="280">
                            <TextBox x:Name="tbxPrenom" Header="Prénom"/>
                            <TextBlock x:Name="tblErrPOrenom" Foreground="Red" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <DatePicker x:Name="dpDateNaissance"
                                     Language="fr-CA"
                                    Header="Date de naissance"/>
                        <TextBlock x:Name="tblErrDateNaissance"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBox x:Name="tbxEmail"
                                 Header="Email"
                                 PlaceholderText="exemple@domaine.com"/>
                        <TextBlock x:Name="tblErrEmail"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBox x:Name="tbxAdresse"
                                 Header="Adresse"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"/>
                        <TextBlock x:Name="tblErrAdresse"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <DatePicker x:Name="dpDateEmbauche"
                                     Language="fr-CA"
                                    Header="Date d'embauche"/>
                        <TextBlock x:Name="tblErrDateEmbauche"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <NumberBox x:Name="nbrTauxHoraire"
                                   Header="Taux horaire ($/h)"/>
                        <TextBlock x:Name="tblErrTauxHoraire"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBox x:Name="photoIdentite"
                                 Header="Photo d'identité (URL)"/>
                        <TextBlock x:Name="tblErrPhotoIdentite"
                                   Foreground="Red"
                                   FontSize="12"/>
                    </StackPanel>

                    <StackPanel>
                        <ToggleSwitch x:Name="tglStatut"
                                      Header="Statut"
                                      OffContent="Journalier"
                                      OnContent="Permanent"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Content="Annuler"
                                Width="140"
                                Click="ButtonAnnuler_Click"/>
                        <Button Content="Enregistrer"
                                Width="160"
                                Click="ButtonEnregistrer_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
