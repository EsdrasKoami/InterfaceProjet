<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAjoutClient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfaceProjet.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid>
            <Grid Padding="40">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            Margin="0,0,0,20">
                    <SymbolIcon Symbol="Add"/>
                    <TextBlock Text="Ajout d'un client"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Spacing="10">

                    <StackPanel>
                        <TextBox x:Name="tbxNom"
                                 Header="Nom"/>
                        <TextBlock x:Name="tblErrNom"
                                   Foreground="Red"/>
                    </StackPanel>

               
                    <StackPanel>
                        <TextBox x:Name="tbxAdresse"
                                 Header="Adresse"
                                 TextWrapping="Wrap"/>
                        <TextBlock x:Name="tblErrAdresse"
                                   Foreground="Red"/>
                    </StackPanel>

              
                    <StackPanel>
                        <TextBox x:Name="tbxTelephone"
                                 Header="Numéro de téléphone"
                                 PlaceholderText="819-563-4521"/>
                        <TextBlock x:Name="tblErrNumeroTelephone"
                                   Foreground="Red"/>
                    </StackPanel>

                    
                    <StackPanel>
                        <TextBox x:Name="tbxEmail"
                                 Header="Email"
                                 PlaceholderText="lilia@gmail.com"/>
                        <TextBlock x:Name="tblErrEmail"
                                   Foreground="Red"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Content="Enregistrer"
                                Width="250"
                                Click="ButtonEnregistrer_Click"/>
                        <Button Content="Annuler"
                                Width="250"
                                Click="ButtonAnnuler_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
