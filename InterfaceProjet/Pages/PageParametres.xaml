<Page
    x:Class="InterfaceProjet.Pages.PageParametres"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <SymbolIcon Symbol="Setting"/>
            <TextBlock Text="Paramètres"
                       FontSize="28"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Spacing="24">


            <!-- Exportation des données -->
            <StackPanel Spacing="8">
                <TextBlock Text="Exportation des données"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <Button Content="Exporter les projets en CSV"
                        Width="250"
                        Click="BtnExporterProjetsCsv_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
