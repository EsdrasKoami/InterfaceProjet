<Page
    x:Class="InterfaceProjet.Pages.PageParametres"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <SymbolIcon Symbol="Setting"/>
            <TextBlock Text="Paramètres"
                       FontSize="28"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Contenu -->
        <StackPanel Grid.Row="1" Spacing="24">

            <!-- Sécurité -->
            <StackPanel Spacing="8">
                <TextBlock Text="Sécurité"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <Button Content="Changer le mot de passe"
                        Width="250"
                        Click="BtnChangerMotDePasse_Click"/>
            </StackPanel>

            <!-- Langue -->
            <StackPanel Spacing="8">
                <TextBlock Text="Langue de l'application"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cbLangue"
                          Width="250"
                          SelectionChanged="cbLangue_SelectionChanged">
                    <ComboBoxItem Content="Français" Tag="fr" IsSelected="True"/>
                    <ComboBoxItem Content="Anglais"  Tag="en"/>
                </ComboBox>
            </StackPanel>

            <!-- Date et heure -->
            <StackPanel Spacing="8">
                <TextBlock Text="Format de date et heure"
                           FontSize="20"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cbFormatDateHeure"
                          Width="250"
                          SelectionChanged="cbFormatDateHeure_SelectionChanged">
                    <ComboBoxItem Content="JJ/MM/AAAA - 24h" Tag="fr-24"/>
                    <ComboBoxItem Content="MM/DD/YYYY - 12h" Tag="en-12"/>
                </ComboBox>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
