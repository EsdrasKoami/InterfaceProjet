<?xml version="1.0" encoding="utf-8"?>
<ContentDialog 
    x:Class="InterfaceProjet.Pages.ModifierProjetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    Title="Modifier un projet"
    PrimaryButtonText="Enregistrer"
    CloseButtonText="Annuler"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    Closing="ContentDialog_Closing">

    <ScrollViewer>
        <StackPanel Padding="20" Spacing="12">

            <StackPanel Spacing="4">
                <TextBlock Text="Titre"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="tbTitre"/>
                <TextBlock x:Name="tbTitreErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>
            
            <StackPanel Spacing="4">
                <TextBlock Text="Date de début"
                           FontWeight="SemiBold"/>
                <DatePicker x:Name="dpDateDebut"/>
                <TextBlock x:Name="tbDateErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Budget"
                           FontWeight="SemiBold"/>
                <NumberBox x:Name="NbBudget"
                         />
                <TextBlock x:Name="tbBudgetErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Nombre d’employés requis (max 5)"
                           FontWeight="SemiBold"/>
                <NumberBox x:Name="NbEmployes"/>
                <TextBlock x:Name="tbNbEmployesErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Statut"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="cbStatut" SelectedItem="0">
                    <ComboBoxItem Content="En cours"/>
                    <ComboBoxItem Content="Terminé"/>
                </ComboBox>
                <TextBlock x:Name="tbStatutErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>


            <StackPanel Spacing="4">
                <TextBlock Text="Description"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="tbDescription"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"/>
                <TextBlock x:Name="tbDescriptionErreur"
                           Foreground="Red"
                           FontSize="12"
                           Visibility="Collapsed"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
