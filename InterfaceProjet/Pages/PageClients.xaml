<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageClients"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollView >
        <Grid>
            <Grid Padding="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,20">
                    <SymbolIcon Symbol="Contact"/>
                    <TextBlock Text="Gestion des clients"
                       FontSize="28"
                       FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="10"
                    Margin="0,0,0,20">
                    <AutoSuggestBox x:Name="tbRechercheProjet"
                    Width="300"
                    PlaceholderText="Rechercher un projet"
                    QueryIcon="Find"
                    TextChanged="tbRechercheProjet_TextChanged"/>
                    <Button Content="Ajouter"
                    x:Name="btnAjouterClient"
                    Click="btnAjouterClient_Click"/>
                    <Button Content="Modifier"
                    x:Name="btnModifierClient"
                    Click="btnModifierClient_Click"/>
                    <Button Content="Supprimer"
                    x:Name="btnSupprimerClient"
                    Click="btnSupprimerClient_Click"/>
                </StackPanel>
                <!--ItemClick="lvClients_ItemClick"-->
                <ListView Grid.Row="2"
                  x:Name="lvClients"
                 >
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local1:Client">
                            <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,5"
                                Spacing="20">
                                <TextBlock Text="{x:Bind IdClient}" Width="50"/>
                                <TextBlock Text="{x:Bind Nom}" Width="150"/>
                                <TextBlock Text="{x:Bind Email}" Width="200"/>
                                <TextBlock Text="{x:Bind Telephone}" Width="120"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

        </Grid>
    </ScrollView>
</Page>
