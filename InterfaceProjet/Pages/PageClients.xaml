<Page
    x:Class="InterfaceProjet.Pages.PageClients"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid>
            <Grid Padding="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="0,0,0,20">
                    <SymbolIcon Symbol="Contact"/>
                    <TextBlock Text="Gestion des clients"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Barre de recherche + bouton Ajouter -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            Margin="0,0,0,20">
                    <AutoSuggestBox x:Name="tbRechercheClient"
                                    Width="300"
                                    PlaceholderText="Rechercher un client"
                                    QueryIcon="Find"
                                    TextChanged="tbRechercheClient_TextChanged"/>
                    <Button Content="Ajouter"
                            x:Name="btnAjouterClient"
                            Click="btnAjouterClient_Click"/>
                </StackPanel>

                <!-- Liste des clients -->
                <ListView Grid.Row="2"
                          x:Name="lvClients"
                          SelectionMode="Single">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <!-- En-tête des colonnes -->
                    <ListView.Header>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <!-- ID -->
                                <ColumnDefinition Width="220"/>
                                <!-- Nom -->
                                <ColumnDefinition Width="320"/>
                                <!-- Email -->
                                <ColumnDefinition Width="150"/>
                                <!-- Téléphone -->
                                <ColumnDefinition Width="120"/>
                                <!-- Actions -->
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="ID"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Nom"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="Email"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="Téléphone"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4"
                                       Text="Actions"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </ListView.Header>

                    <!-- Lignes de données -->
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local1:Client">
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind IdClient}"
                                           HorizontalAlignment="Stretch"
                                           TextAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Nom}"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind Email}"
                                           HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Telephone}"
                                           HorizontalAlignment="Center"/>

                                <!-- Actions (Modifier / Supprimer) -->
                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">

                                    <Button Click="ButtonModifier_Click"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <SymbolIcon Symbol="Edit"/>
                                    </Button>

                                    <Button Click="ButtonSupprimer_Click"
                                            Background="Transparent"
                                            BorderThickness="0">
                                        <SymbolIcon Symbol="Delete"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
