<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAssignationEmploye"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="Auto"/>
            <!-- Recherche -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,20">
            <SymbolIcon Symbol="Contact" VerticalAlignment="Center"/>
            <TextBlock Text="Assigner un employé au projet"
                       FontSize="28"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Barre de recherche -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">
            <AutoSuggestBox x:Name="tbRechercheEmploye"
                            Width="400"
                            HorizontalAlignment="Left"
                            PlaceholderText="Rechercher un employé (nom, prénom, matricule...)"
                            QueryIcon="Find"
                            TextChanged="tbRechercheEmploye_TextChanged"/>
        </StackPanel>

        <!-- Liste des employés -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="lvEmployes"
                      SelectionMode="Single"
                      IsItemClickEnabled="False">

                <!-- Style des items -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- En-tête -->
                <ListView.Header>
                    <Grid Padding="12,12,12,8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <!-- Matricule -->
                            <ColumnDefinition Width="180"/>
                            <!-- Nom -->
                            <ColumnDefinition Width="180"/>
                            <!-- Prénom -->
                            <ColumnDefinition Width="*"/>
                            <!-- Email -->
                            <ColumnDefinition Width="140"/>
                            <!-- Taux -->
                            <ColumnDefinition Width="120"/>
                            <!-- Statut -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Matricule"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Nom"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                                   Text="Prénom"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3"
                                   Text="Email"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4"
                                   Text="Taux horaire"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5"
                                   Text="Statut"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>

                <!-- Lignes -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local1:Employe">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind Matricule}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Nom}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Prenom}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind Email}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4"
                                       Text="{x:Bind TauxHoraireFormate}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="5"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Statut}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button x:Name="btnAnnuler"
                    Content="Annuler"
                    MinWidth="120"
                    Click="btnAnnuler_Click"/>
            <Button x:Name="btnChoisirEmploye"
                    Content="Assigner cet employé"
                    MinWidth="180"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="btnChoisirEmploye_Click"/>
        </StackPanel>
    </Grid>
</Page>