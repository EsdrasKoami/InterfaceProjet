<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAssignationEmploye"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid Padding="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,20">
                <SymbolIcon Symbol="Contact"/>
                <TextBlock Text="Assignation d’un employé au projet"
                           FontSize="24"
                           FontWeight="SemiBold"/>
            </StackPanel>

            
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="0,0,0,20">
                <AutoSuggestBox x:Name="tbRechercheEmploye"
                                Width="320"
                                PlaceholderText="Rechercher un employé (nom, prénom, matricule...)"
                                QueryIcon="Find"
                                TextChanged="tbRechercheEmploye_TextChanged"/>
            </StackPanel>

            
            <ListView Grid.Row="2"
                      x:Name="lvEmployes"
                      SelectionMode="Single">

               
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                
                <ListView.Header>
                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            
                            <ColumnDefinition Width="160"/>
                           
                            <ColumnDefinition Width="160"/>
                            
                            <ColumnDefinition Width="260"/>
                           
                            <ColumnDefinition Width="120"/>
                           
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Matricule"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="Nom"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2"
                                   Text="Prénom"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3"
                                   Text="Email"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="4"
                                   Text="Statut"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Grid>
                </ListView.Header>

               
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Matricule}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Nom}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Prenom}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Email}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Statut}"
                                       HorizontalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,20,0,0">
                <Button x:Name="btnChoisirEmploye"
                        Content="Choisir cet employé"
                        Click="btnChoisirEmploye_Click"
                        Width="180"/>
                <Button x:Name="btnAnnuler"
                        Content="Annuler"
                        Click="btnAnnuler_Click"
                        Width="120"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
