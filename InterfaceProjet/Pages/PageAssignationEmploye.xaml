<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAssignationEmploye"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Fond assombri comme un dialog -->
    <Grid Background="#66000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Boîte centrale -->
        <Border Grid.Row="1"
                Width="900"
                Background="White"
                Padding="24"
                CornerRadius="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Titre -->
                    <RowDefinition Height="Auto"/>
                    <!-- Recherche -->
                    <RowDefinition Height="*"/>
                    <!-- Liste -->
                    <RowDefinition Height="Auto"/>
                    <!-- Boutons -->
                </Grid.RowDefinitions>

                <!-- Titre -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,0,12">
                    <SymbolIcon Symbol="Contact"/>
                    <TextBlock Text="Choisir un employé pour le projet"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Barre de recherche -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,0,0,12">
                    <AutoSuggestBox x:Name="tbRechercheEmploye"
                                    Width="320"
                                    PlaceholderText="Rechercher un employé (nom, prénom, matricule...)"
                                    QueryIcon="Find"
                                    TextChanged="tbRechercheEmploye_TextChanged"/>
                </StackPanel>

                <!-- Liste des employés -->
                <Border Grid.Row="2"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer>
                        <ListView x:Name="lvEmployes"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True">

                            <!-- Pas de padding autour des items -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <!-- En-tête -->
                            <ListView.Header>
                                <Grid Padding="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <!-- Matricule -->
                                        <ColumnDefinition Width="160"/>
                                        <!-- Nom -->
                                        <ColumnDefinition Width="160"/>
                                        <!-- Prénom -->
                                        <ColumnDefinition Width="260"/>
                                        <!-- Email -->
                                        <ColumnDefinition Width="120"/>
                                        <!-- Statut -->
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Matricule"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Nom"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="Prénom"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                               Text="Email"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4"
                                               Text="Statut"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                </Grid>
                            </ListView.Header>

                            <!-- Lignes -->
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local1:Employe">
                                    <Grid Padding="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{x:Bind Matricule}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Nom}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{x:Bind Prenom}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind Email}"
                                                   HorizontalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4"
                                                   Text="{x:Bind Statut}"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>

                <!-- Boutons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8"
                            Margin="0,16,0,0">
                    <Button x:Name="btnAnnuler"
                            Content="Annuler"
                            Click="btnAnnuler_Click"/>
                    <Button x:Name="btnChoisirEmploye"
                            Content="Choisir cet employé"
                            Background="#0078D7"
                            Foreground="White"
                            Click="btnChoisirEmploye_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>
