<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageProjets"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfaceProjet.Pages"
     xmlns:local1="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollView >
        <Grid>
            <Grid Padding="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
         Orientation="Horizontal"
         Spacing="10"
         Margin="0,0,0,20">
                    <SymbolIcon Symbol="Folder"/>
                    <TextBlock Text="Liste des projets"
            FontSize="28"
            FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="30" Grid.Row="1">
                    <StackPanel  Orientation="Horizontal" Spacing="8" Margin="0,30,0,0">
                        <AutoSuggestBox x:Name="tbRechercheProjet"
                    Width="300"
                    PlaceholderText="Rechercher un projet"
                    QueryIcon="Find"
                    TextChanged="tbRechercheProjet_TextChanged_1"/>
                    </StackPanel>
                    <Button x:Name="btnAjouter" Click="btnAjouter_Click" Grid.Row="4" HorizontalAlignment="Left" Margin="0,30,0,0" >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Add"/>
                            <TextBlock Text="Ajouter un projet"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <GridView x:Name="listeProjets"
Grid.Row="2"
SelectionChanged="listeProjets_SelectionChanged" Margin="0,30,0,0">

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,16,16"/>
                            <Setter Property="MinWidth" Value="280"/>
                            <Setter Property="MaxWidth" Value="280"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local1:Projet">
                            <Border Padding="14"
                      CornerRadius="14"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource SystemAccentColorDark1}"
                      BorderThickness="2">  
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    
                                    <!-- HEADER -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Numéro -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Statut -->
                                            <ColumnDefinition Width="Auto"/>
                                            <!-- Bouton edit -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Numéro du projet -->
                                        <TextBlock Text="{x:Bind NumeroProjet}"
                                           FontWeight="Bold"
                                           FontSize="16"
                                           Grid.Column="0"/>

                                        <!-- Badge Statut -->
                                        <Border Grid.Column="1"
                                            Background="#1F008000"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Statut}"
                                               FontSize="12"
                                               Foreground="#FF008000"/>         
                                        </Border>

                                        <!-- Bouton édition -->
                                        <Button Grid.Column="2"
                                        Click="ButtonModifier_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"> 
                                            <SymbolIcon Symbol="Edit"/>
                                        </Button>
                                    </Grid>


                                    <!-- INFOS -->
                                    <StackPanel Grid.Row="1"
                                          Margin="0,8,0,8"
                                          Spacing="2">      
                                        <TextBlock Text="{x:Bind Titre}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"/>

                                        <TextBlock Text="{x:Bind NomClient}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextWrapping="Wrap"/>

                                        <!-- Date formatée -->
                                        <TextBlock FontSize="12">
                  <Run Text="Début : "/>
                  <Run Text="{x:Bind DateDebut, Mode=OneWay}"/>
                                        </TextBlock>

                                        <!-- Budget formaté -->
                                        <TextBlock FontSize="12">
                  <Run Text="Budget : "/>
                  <Run Text="{x:Bind Budget, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- BOUTON -->
                                    <Button Grid.Row="2"
                                  x:Name="assigner"
                  Content="Assigner"
                  HorizontalAlignment="Right"
                  Margin="0,4,0,0"
                  Style="{ThemeResource AccentButtonStyle}"
                  Click="assigner_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>



            </Grid>
        </Grid>
    </ScrollView>
</Page>
