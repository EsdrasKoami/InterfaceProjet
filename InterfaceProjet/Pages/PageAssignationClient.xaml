<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAssignationClient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfaceProjet.Pages"
    xmlns:models="using:InterfaceProjet.Classes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titre -->
            <RowDefinition Height="Auto"/>
            <!-- Recherche -->
            <RowDefinition Height="*"/>
            <!-- Liste -->
            <RowDefinition Height="Auto"/>
            <!-- Boutons -->
        </Grid.RowDefinitions>

        <!-- Titre -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,0,0,20">
            <SymbolIcon Symbol="Contact" VerticalAlignment="Center"/>
            <TextBlock Text="Sélectionner un client pour le projet"
                       FontSize="28"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Barre de recherche -->
        <StackPanel Grid.Row="1"
                    Margin="0,0,0,20">
            <AutoSuggestBox x:Name="tbRechercheClient"
                            Width="400"
                            HorizontalAlignment="Left"
                            PlaceholderText="Rechercher un client (nom, email, téléphone)"
                            QueryIcon="Find"
                            TextChanged="tbRechercheClient_TextChanged"/>
        </StackPanel>

        <!-- Liste des clients -->
        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ListView x:Name="lvClients"
                      SelectionMode="Single"
                      IsItemClickEnabled="False">

                <!-- Style des items -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <!-- En-tête -->
                <ListView.Header>
                    <Grid Padding="12,12,12,8"
                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <!-- ID -->
                            <ColumnDefinition Width="*"/>
                            <!-- Nom -->
                            <ColumnDefinition Width="*"/>
                            <!-- Email -->
                            <ColumnDefinition Width="180"/>
                            <!-- Téléphone -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="ID"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="Nom"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2"
                                   Text="Email"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3"
                                   Text="Téléphone"
                                   FontWeight="SemiBold"/>
                    </Grid>
                </ListView.Header>

                <!-- Lignes -->
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Client">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind IdClient}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind Nom}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind Email}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3"
                                       Text="{x:Bind Telephone}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Boutons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="12"
                    Margin="0,20,0,0">
            <Button x:Name="btnAnnuler"
                    Content="Annuler"
                    MinWidth="120"
                    Click="btnAnnuler_Click"/>
            <Button x:Name="btnChoisir"
                    Content="Choisir ce client"
                    MinWidth="160"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="btnChoisir_Click"/>
        </StackPanel>
    </Grid>
</Page>