<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageConnexion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- Centrer la carte de connexion -->
        <Grid HorizontalAlignment="Center" 
              VerticalAlignment="Center"
              MaxWidth="450">

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40"
                    >

                <StackPanel Spacing="20">

                    <!-- ICÔNE + TITRE -->
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Width="64"
                                Height="64"
                                CornerRadius="32"
                                HorizontalAlignment="Center">
                            <SymbolIcon Symbol="Admin" 
                                        Foreground="White"
                                        RenderTransformOrigin="0.5,0.5">
                                <SymbolIcon.RenderTransform>
                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                </SymbolIcon.RenderTransform>
                            </SymbolIcon>
                        </Border>

                        <TextBlock Text="Connexion Administrateur"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Veuillez entrer vos identifiants"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- CHAMPS DE SAISIE -->
                    <StackPanel Spacing="16" Margin="0,10,0,0">

                        <!-- NOM D'UTILISATEUR -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Nom d'utilisateur" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtUsername"
                                     PlaceholderText="Entrez votre nom d'utilisateur"
                                     KeyDown="Input_KeyDown"/>
                        </StackPanel>

                        <!-- MOT DE PASSE -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Mot de passe" 
                                       FontWeight="SemiBold"/>
                            <PasswordBox x:Name="txtPassword"
                                         PlaceholderText="Entrez votre mot de passe"
                                         KeyDown="Input_KeyDown"/>
                        </StackPanel>

                        <!-- MESSAGE D'ERREUR -->
                        <Border x:Name="errorBorder"
                                Background="#20FF0000"
                                BorderBrush="#FFFF0000"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Important" 
                                            Foreground="#FFFF0000"
                                            VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtError"
                                           Foreground="#FFFF0000"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- MESSAGE DE SUCCÈS -->
                        <Border x:Name="successBorder"
                                Background="#2000FF00"
                                BorderBrush="#FF00FF00"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="Accept" 
                                            Foreground="#FF00AA00"
                                            VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtSuccess"
                                           Foreground="#FF00AA00"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- BOUTONS -->
                    <StackPanel Spacing="12" Margin="0,10,0,0">
                        <Button x:Name="btnConnexion"
                                Content="Se connecter"
                                Click="btnConnexion_Click"
                                HorizontalAlignment="Stretch"
                                Style="{ThemeResource AccentButtonStyle}"
                                Height="40"/>

                        <Button x:Name="btnAnnuler"
                                Content="Annuler"
                                Click="btnAnnuler_Click"
                                HorizontalAlignment="Stretch"
                                Height="40"/>
                    </StackPanel>

                    <!-- STATUT DE CONNEXION ACTUEL -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon x:Name="iconStatut" 
                                        Symbol="Contact"
                                        VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtStatut"
                                       Text="Aucun administrateur connecté"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>