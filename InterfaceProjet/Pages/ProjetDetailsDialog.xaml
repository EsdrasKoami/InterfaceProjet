<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="InterfaceProjet.Pages.ProjetDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    PrimaryButtonText="Fermer"
    DefaultButton="Primary"
    Title="Détails du projet"
    MinWidth="460"
    MaxWidth="520">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="Auto"/>
           
            <RowDefinition Height="*"/>
            
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <!-- =================== INFOS PROJET =================== -->
        <StackPanel Grid.Row="0" Spacing="6">
            <!-- Numéro + titre -->
            <TextBlock Text="{x:Bind Projet.NumeroProjet}"
                       FontSize="22"
                       FontWeight="Bold" />

            <TextBlock Text="{x:Bind Projet.Titre}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <!-- Client -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Client : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.NomClient}" />
            </StackPanel>

            <!-- Date de début -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Date de début : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.DateDebut}" />
            </StackPanel>

            <!-- Budget -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Budget : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.Budget}" />
            </StackPanel>

            <!-- Statut -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Statut : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.Statut}" />
            </StackPanel>
        </StackPanel>

        <!-- =================== TITRE SECTION EMPLOYÉS =================== -->
        <TextBlock Grid.Row="1"
                   Text="Employés assignés"
                   Margin="0,16,0,4"
                   FontSize="16"
                   FontWeight="SemiBold" />

        <!-- =================== LISTE EMPLOYÉS =================== -->
        <Border Grid.Row="2"
        BorderThickness="1"
        BorderBrush="#22000000"
        CornerRadius="8"
        Padding="8"
        Background="#0FFFFFFF">

            <ListView x:Name="lvAssignations"
              ItemsSource="{x:Bind Assignation}"
              SelectionMode="None"
              MaxHeight="220">

                <!-- En-tête du tableau -->
                <ListView.Header>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <!-- Employé -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Taux -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Heures -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Salaire -->
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                           Text="Employé"
                           FontWeight="SemiBold"/>

                        <TextBlock Grid.Column="1"
                           Text="Taux"
                           FontWeight="SemiBold"
                           Margin="16,0,0,0"
                           TextAlignment="Right"/>

                        <TextBlock Grid.Column="2"
                           Text="Heures"
                           FontWeight="SemiBold"
                           Margin="16,0,0,0"
                           TextAlignment="Right"/>

                        <TextBlock Grid.Column="3"
                           Text="Salaire"
                           FontWeight="SemiBold"
                           Margin="16,0,0,0"
                           TextAlignment="Right"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local1:Assignation">
                        <Grid Padding="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nom employé -->
                            <TextBlock Grid.Column="0"
                               Text="{x:Bind Employe.Nom}" />

                            <!-- Taux horaire -->
                            <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               TextAlignment="Right"
                               Text="{x:Bind Employe.TauxHoraireFormate}" />

                            <!-- Heures -->
                            <TextBlock Grid.Column="2"
                               Margin="16,0,0,0"
                               TextAlignment="Right"
                               Text="{x:Bind HeuresTravaillees}" />

                            <!-- Salaire -->
                            <TextBlock Grid.Column="3"
                               Margin="16,0,0,0"
                               TextAlignment="Right"
                               Text="{x:Bind SalaireAPayer}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- =================== TOTAL =================== -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock Text="Total des salaires : "
                       FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind TotalSalaires}" />
        </StackPanel>

    </Grid>
</ContentDialog>
