<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="InterfaceProjet.Pages.ProjetDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local1="using:InterfaceProjet.Classes"
    PrimaryButtonText="Fermer"
    DefaultButton="Primary">

    <StackPanel Padding="20" Spacing="16">

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind Projet.NumeroProjet}" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{x:Bind Projet.Titre}" FontSize="18"/>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Client : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.NomClient}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Date de début : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.DateDebut}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Budget : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.Budget}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Statut : " FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind Projet.Statut}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Employés assignés" 
                   FontWeight="SemiBold" 
                   Margin="0,10,0,0"/>


        <ListView 
          SelectionMode="None"
          Height="200">

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local1:Assignation">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{x:Bind Employe.Nom}" Width="100"/>
                        <TextBlock Text="{x:Bind Employe.Prenom}" Width="120"/>
                        <TextBlock Text="{x:Bind Employe.TauxHoraire}" Width="80"/>
                        <TextBlock Text="{x:Bind HeuresTravaillees}" Width="80"/>
                        <TextBlock Text="{x:Bind SalaireAPayer}" Width="100"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>



        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <TextBlock Text="Total des salaires : " FontWeight="SemiBold"/>
            <TextBlock Text="{x:Bind TotalSalaires}"/>
        </StackPanel>

    </StackPanel>
</ContentDialog>
