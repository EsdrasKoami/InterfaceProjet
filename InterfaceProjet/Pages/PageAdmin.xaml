<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="InterfaceProjet.Pages.PageAdmin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:InterfaceProjet.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="350"
                    Padding="20"
                    Background="White"
                    CornerRadius="10">

            <TextBlock Text="Création du compte administrateur"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- USERNAME -->
            <TextBlock Text="Nom d'utilisateur" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox"
                     PlaceholderText="Entrez votre nom"
                     Margin="0,0,0,15"/>

            <!-- PASSWORD -->
            <TextBlock Text="Mot de passe" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox"
                         PlaceholderText="Mot de passe"
                         Margin="0,0,0,15"/>

            <!-- CONFIRM PASS -->
            <TextBlock Text="Confirmer le mot de passe" Margin="0,0,0,5"/>
            <PasswordBox x:Name="ConfirmPasswordBox"
                         PlaceholderText="Confirmez le mot de passe"
                         Margin="0,0,0,10"/>

            <!-- MESSAGE D'ERREUR -->
            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"/>

            <Button Content="Valider"
                    Click="Button_Click"
                    Background="#0078D7"
                    Foreground="White"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</Page>
